<?xml version="1.0" encoding="utf-8"?>
     <configuration>
     <system.webServer>
       <handlers>
        <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\websites\IPL_API\venv\Scripts\python.exe|C:\websites\IPL_API\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
       </handlers>
     </system.webServer>
     <appSettings>
       <!-- Required settings -->
       <add key="WSGI_HANDLER" value="run.app" />
       <add key="PYTHONPATH" value="C:\websites\IPL_API" />
       <add key="WSGI_LOG" value="C:\websites\IPL_API\wfastcgi.log" /> 
     </appSettings>
     <system.web>
        <customErrors mode="Off" />
      </system.web>
    </configuration>